# Copy this file to .env.local and fill in your own values.

# Neon (Postgres) pooled connection string — see README "Set up the database".
DATABASE_URL=postgresql://USER:PASSWORD@ep-...-pooler.REGION.aws.neon.tech/DB?sslmode=require

# Notion — only needed for the Activities tab (see README "Activities (Notion)").
# Leave unset to hide/disable that tab.
NOTION_TOKEN=secret_your-internal-integration-token
NOTION_ACTIVITIES_DB_ID=your-activities-database-id
